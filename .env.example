# Copy this file to .env.local and fill in what you need. .env.local is git-ignored and never uploaded.

# The bird's brain: a local model through Ollama (https://ollama.com). Defaults shown; uncomment to change.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:8b
# Let the model think before it speaks: a little deeper, but 10-40s per line instead of ~2s.
# OLLAMA_THINK=true
# Set to "claude" to use Claude first and the local model as backup.
# BIRD_BRAIN=claude

# Optional: a Claude API key, used only as a backup when the local model isn't available.
ANTHROPIC_API_KEY=
# A passcode required to open the app (recommended when using it from your phone on Wi-Fi).
APP_PASSCODE=

# Optional: where your thoughts are stored (default: data/mind.db, which is git-ignored).
# TIMEFLOW_DB=data/mind.db
